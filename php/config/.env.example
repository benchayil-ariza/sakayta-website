# SakayTa — local configuration template (FINAL SRS foundation)
# --------------------------------------------------------------------------
# COPY this file to php/config/.env  (the real .env is git-ignored and must
# never be committed). All values below are DEV defaults for a stock XAMPP
# install; production must override through the real environment and never
# commit a .env file.
# --------------------------------------------------------------------------

# Application environment: development | production
SAKAYTA_ENV=development

# --- MariaDB connection (used by the PHP app) -------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sakayta
DB_USER=sakayta
DB_PASSWORD=sakayta-dev-password-change-me
DB_CHARSET=utf8mb4

# --- MariaDB bootstrap credentials (schema create only; root default) -------
# Used by php/bin/00_bootstrap_db.php to create the database + app user.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Set to 1 to also create the dedicated app user above (DB_USER) and grant it
# on sakayta.*. Leave empty on stock XAMPP where the app connects as root and
# CREATE USER may hit MariaDB Aria system-table checksum errors (error 176).
DB_CREATE_APP_USER=

# --- Authentication ---------------------------------------------------------
AUTH_TOKEN_SECRET=your-random-secret-key-here
