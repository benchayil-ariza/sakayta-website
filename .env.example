# Copy this file to .env and fill in your own values

PORT=3000

# RabbitMQ connection (default is fine if running RabbitMQ locally via Docker)
RABBITMQ_URL=amqp://localhost

# Where your PHP SOAP service is running
SOAP_URL=http://localhost:8080/driverVerification.php?wsdl

# Optional: sign up free at https://openrouteservice.org/dev/#/signup
# Leave blank and the app automatically falls back to a straight-line distance estimate
ORS_API_KEY=
